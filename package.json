{
  "name": "experimental-earth-runoff-workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs; a=$?; PYTHONPATH=. python3 -m unittest discover -s tests -p 'test_*.py'; b=$?; exit $((a || b))",
    "serve": "python3 serve.py",
    "browser-receive": "node tests/browser.receiving.mjs",
    "build:preview": "node scripts/build-browser-preview.mjs",
    "check:preview": "node scripts/build-browser-preview.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
